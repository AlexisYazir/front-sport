{
  "name": "ecommerce-app",
  "version": "1.0.0",
  "description": "Sport Center - E-commerce application with authentication and role-based access control",
  "author": "Sport Center Team",
  "license": "PRIVATE",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --stats-json && node scripts/prepare-netlify-shell.mjs",
    "preview:pwa": "node scripts/serve-pwa.mjs",
    "verify:pwa": "node scripts/verify-pwa-deploy.mjs",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:pwa": "node --test scripts/pwa-worker.spec.mjs scripts/pwa-storage-worker.spec.mjs scripts/prepare-netlify-shell.spec.mjs scripts/prepare-offline-manifest.spec.mjs && ng test --watch=false --browsers=ChromeHeadless --ts-config=tsconfig.pwa.spec.json --include=src/app/core/services/public-*.spec.ts --include=src/app/core/services/pwa-storage.service.spec.ts",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@angular/service-worker": "20.3.34",
    "@lucide/angular": "^1.28.0",
    "@primeng/themes": "^21.0.4",
    "@tailwindcss/postcss": "^4.1.16",
    "chart.js": "^4.5.1",
    "choices.js": "^11.1.0",
    "jspdf": "^4.2.1",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.15.0",
    "ng2-charts": "^8.0.0",
    "ngx-pagination": "^6.0.3",
    "ngx-toastr": "^19.1.0",
    "postcss": "8.5.31",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.16",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.40",
    "@angular/cli": "20.3.40",
    "@angular/compiler-cli": "20.3.34",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/maplibre-gl": "^1.13.2",
    "eslint-plugin-security": "^4.0.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
