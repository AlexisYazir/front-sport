{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css$",
          "/main-*.js$", "/polyfills-*.js$", "/pwa-worker.js$",
          "/icons/icon-192.png$", "/icons/icon-512.png$", "/icons/icon-maskable-512.png$",
          "/assets/images/logo_sportcenter.png$", "/assets/images/no_imagen.webp$", "/favicon.ico$"
        ]
      }
    },
    {
      "name": "features",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/*.js$"] }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/**", "/icons/**", "/*.ico$"],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": []
}
