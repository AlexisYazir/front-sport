{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css$",
          "/*.js$",
          "/icons/*.png$",
          "/assets/images/**",
          "/*.ico$"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/**", "/favicon.ico"],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "public-catalog-images",
      "urls": [
        "^https://res.cloudinary.com/**",
        "^https://http2.mlstatic.com/**",
        "^https://m.media-amazon.com/**",
        "^https://imgs.search.brave.com/**",
        "^https://images.seeklogo.com/**",
        "^https://operadorapalermo.com.mx/**",
        "^https://ui-avatars.com/**",
        "^https://back-sport-ghxk.onrender.com/uploads/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxSize": 2048,
        "maxAge": "365d",
        "cacheOpaqueResponses": false
      }
    }
  ]
}
